      "frames": [0],
      "expected_assets": ["procedural:SRC_mask_samples_rgba_split"],
      "desired_output": "ae_probe_outputs/png/GMD_MASK_DEFAULT/GMD_MASK_DEFAULT_[#####].png",
      "question": "With threshold=120 radius=0 intensity=1 and property 0001 absent, which RGBA samples produce Glow output?"
    },
    {
      "id": "GMD_MASK_BASEDON_1",
