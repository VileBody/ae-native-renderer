{
  "schema": "ae-native-renderer.conformance-pack.v1",
  "pack_id": "ae_conformance_pack_v1",
  "purpose": "AE-generated golden frames for primitive/operator/stack/template-slice parity work",
  "composition": {
    "width": 512,
    "height": 512,
    "fps": 30,
    "case_duration_seconds": 2.0,
    "master_comp": "master_conformance_reel"
  },
  "required_fonts": [
    {
      "family_or_postscript": "Montserrat-BoldItalic",
      "used_by": ["TXT_010", "TXT_020"],
      "source_note": "Montserrat is OFL and available from Google Fonts; variable italic TTF is included in assets/fonts for convenience."
    },
    {
      "family_or_postscript": "Point-Light",
      "used_by": ["TXT_030", "TXT_040"],
      "source_note": "Point-Light.ttf is provided locally for native conformance runs; AE goldens were rendered with the matching installed Point-Light face."
    }
  ],
  "assets": {
    "primitive_manifest": "assets/primitives/assets_manifest.json",
    "numbered_frame_sequence": "assets/primitives/numbered_frames/frame_0000.png",
