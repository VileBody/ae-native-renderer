      "assets/fonts/Montserrat-Italic[wght].ttf",
      "assets/fonts/Point-Light.ttf",
      "assets/fonts/OFL-Montserrat.txt"
    ]
  },
  "render_outputs": {
    "individual_png_sequences": "ae_goldens/png/<case_id>/<case_id>_[#####].png",
    "master_preview": "ae_goldens/preview/master_conformance_reel"
  },
  "case_ladder": [
    "primitive",
    "property_interpolation",
    "operator_static",
    "animated_operator",
    "stack",
    "template_slice",
    "full_template"
