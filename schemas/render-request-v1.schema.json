{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ae-native-renderer.render-request.v1",
  "title": "AE Native Renderer JSON Request v1",
  "type": "object",
  "required": ["schema", "action", "projectSpec", "compsSpec"],
  "properties": {
    "schema": {
      "const": "ae-native-renderer.render-request.v1",
      "default": "ae-native-renderer.render-request.v1"
    },
    "requestId": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "action": {
      "enum": ["validate", "inspect", "render"],
      "default": "render"
    },
    "payloadVersion": { "type": ["string", "null"] },
    "projectSpec": {
      "type": "object",
      "required": ["mainCompName"],
      "properties": {
        "mainCompName": { "type": "string", "minLength": 1 },
        "subtitlesMode": { "type": ["string", "null"] },
        "colorManagement": {
          "type": "object",
          "properties": {
            "workingSpace": { "type": "string", "default": "none" },
            "linearBlending": { "type": "boolean", "default": false },
            "outputSpace": { "type": "string", "default": "srgb" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "compsSpec": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "w", "h", "fps", "dur"],
        "properties": {
          "name": { "type": "string" },
          "w": { "type": "integer", "minimum": 1 },
          "h": { "type": "integer", "minimum": 1 },
          "fps": { "type": "number", "exclusiveMinimum": 0 },
          "dur": { "type": "number", "exclusiveMinimum": 0 },
          "pixelAspect": { "type": "number", "exclusiveMinimum": 0 },
          "bgColor": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          }
        },
        "additionalProperties": true
      }
    },
    "footage_layers": {
      "type": "array",
      "items": { "$ref": "#/$defs/layer" },
      "default": []
    },
    "text_layers": {
      "type": "array",
      "items": { "$ref": "#/$defs/layer" },
      "default": []
    },
    "visualOps": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/visualOperation" }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "fonts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "asset_roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "layer_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "plugins": {
          "type": "array",
          "items": { "type": "string" }
        },
        "audio_required": { "type": "boolean" },
        "external_plugins_policy": { "type": "string" }
      },
      "additionalProperties": true
    },
    "styleRegistry": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/registryEntry" }
    },
    "effectRegistry": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/registryEntry" }
    },
    "goldenRefs": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/goldenRef" }
    },
    "assetsSpec": {
      "type": "object",
      "properties": {
        "root": { "type": ["string", "null"] },
        "jobArchive": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "outputSpec": {
      "type": "object",
      "properties": {
        "directory": { "type": "string", "default": "out" },
        "video": { "type": ["string", "null"] },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 },
          "description": "Exact source composition frame indices. Requests are sorted and deduplicated before rendering."
        },
        "writeScene": { "type": "boolean", "default": true }
      },
      "not": {
        "required": ["video", "frames"],
        "properties": {
          "video": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "debugSpec": {
      "type": "object",
      "properties": {
        "captureEffectStages": { "type": "boolean", "default": false },
        "sourceLayers": { "type": "boolean", "default": false },
        "preEffects": { "type": "boolean", "default": false },
        "textMasks": { "type": "boolean", "default": false },
        "adjustmentResults": { "type": "boolean", "default": false },
        "precompResults": { "type": "boolean", "default": false },
        "finalComposite": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "tuningSpec": {
      "type": "object",
      "properties": {
        "profile": {
          "type": ["string", "null"],
          "description": "builtin:p0p1-readiness or a path relative to the request JSON"
        },
        "overrides": {
          "type": "object",
          "default": {},
          "description": "Deep-merged strict overrides; unknown fields fail validation"
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "onUnsupported": {
          "enum": ["report", "error"],
          "default": "report"
        },
        "strict": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "required": ["name", "type", "in_point", "out_point", "z_index"],
      "properties": {
        "name": { "type": "string" },
        "type": {
          "enum": ["solid", "footage", "text", "precomp", "adjustment"]
        },
        "in_point": { "type": "number" },
        "out_point": { "type": "number" },
        "z_index": { "type": "integer" },
        "text": { "type": "string", "default": "" },
        "adjustment_layer": { "type": "boolean", "default": false },
        "props": { "type": "object", "default": {} },
        "effects": { "type": "object", "default": {} },
        "text_data": { "type": "object", "default": {} },
        "source_rect": { "type": "object", "default": {} }
      },
      "additionalProperties": true
    },
    "visualOperation": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "type": { "type": "string", "minLength": 1 },
        "target": {
          "type": "object",
          "properties": {
            "composition": { "type": ["string", "null"] },
            "layer": { "type": ["string", "null"] },
            "place": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "timing": {
          "type": "object",
          "properties": {
            "start": { "type": ["number", "null"] },
            "duration": { "type": ["number", "null"] },
            "end": { "type": ["number", "null"] },
            "anchor": { "type": ["string", "null"] },
            "offset": { "type": ["number", "null"] }
          },
          "additionalProperties": false
        },
        "params": { "type": "object", "default": {} },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "path"],
            "properties": {
              "role": {
                "enum": ["audio", "tts_audio", "overlay", "matte"]
              },
              "path": { "type": "string" },
              "optional": { "type": "boolean", "default": false }
            },
            "additionalProperties": false
          }
        },
        "required": { "type": "boolean", "default": true }
      },
      "additionalProperties": true
    },
    "registryEntry": {
      "type": "object",
      "properties": {
        "styleId": { "type": "string" },
        "stableId": { "type": "string" },
        "aeMatchName": { "type": "string" },
        "version": { "type": "string" },
        "backend": { "type": "string" },
        "parity": { "type": "string" },
        "fallbackPolicy": { "type": "string" }
      },
      "additionalProperties": true
    },
    "goldenRef": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "artifactJobId": { "type": "string" },
        "jobId": { "type": "string" },
        "family": { "type": "string" },
        "status": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
